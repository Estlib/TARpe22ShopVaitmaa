@model IEnumerable<TARpe22ShopVaitmaa.Models.Spaceship.SpaceshipIndexViewModel>
@{
    int rowNumber = 1;
}
<div class="h1">
    Products
</div>
<div>
    <a id="testIdAdd" asp-action="create" asp-controller="spaceships" type="submit" class="btn btn-primary">Add</a>
</div>

<form method="post">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Name</th>
                <th scope="col">Type</th>
                <th scope="col">Passengers</th>
                <th scope="col">Engine Power</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var spaceship in Model)
            {                
                <tr>
                    <td id="testIdRN#">@rowNumber</td>
                    <td id="testIdNAM_I">@spaceship.Name</td>
                    <td id="testIdTYP_I">@spaceship.Type</td>
                    <td id="testIdPCT_I">@spaceship.PassengerCount</td>
                    <td id="testIdEPW_I">@spaceship.EnginePower</td>
                    <td>
                        <a id="testIdDET" asp-action="details" asp-controller="spaceships" asp-route-id="@spaceship.Id" class="btn btn-info">Details</a>
                        <a id="testIdMOD" asp-action="update" asp-controller="spaceships" asp-route-id="@spaceship.Id" class="btn btn-primary">Edit</a>
                        <a id="testIdDEL" asp-action="delete" asp-controller="spaceships" asp-route-id="@spaceship.Id" class="btn btn-danger">Delete</a>
                    </td>
                </tr>
                rowNumber +=1;
            }
        </tbody>
    </table>
</form>
